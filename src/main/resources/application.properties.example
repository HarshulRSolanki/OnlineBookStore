spring.application.name=OnlineBookStore

# Database Configuration
spring.datasource.url=jdbc:mysql://localhost:3306/onlinebookstore
spring.datasource.username=YOUR_DATABASE_USERNAME
spring.datasource.password=YOUR_DATABASE_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# Server Configuration
server.port=8525
server.error.whitelabel.enabled=false

# Email Configuration
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=YOUR_EMAIL@gmail.com
spring.mail.password=YOUR_EMAIL_APP_PASSWORD
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.ssl.trust=smtp.gmail.com
spring.mail.properties.mail.smtp.starttls.required=true
spring.mail.properties.mail.smtp.connectiontimeout=5000
spring.mail.properties.mail.smtp.timeout=5000
spring.mail.properties.mail.smtp.writetimeout=5000

# Stripe Configuration
stripe.api.key=YOUR_STRIPE_SECRET_KEY
stripe.public.key=YOUR_STRIPE_PUBLIC_KEY

# File Configuration
spring.servlet.multipart.enabled=true

# Session timeout limit
server.servlet.session.timeout=300s

# Multipart limits
spring.servlet.multipart.max-file-size=150MB
spring.servlet.multipart.max-request-size=300MB
spring.servlet.multipart.strict-servlet-compliance=true
server.servlet.http2.max-response-header-size=1000000

